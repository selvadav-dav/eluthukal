{
  "name": "agaram-backend",
  "version": "1.0.0",
  "description": "Production-ready Node.js + Express + MySQL REST API Backend for AGARAM Tamil Educational Application",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:init": "node src/scripts/initDb.js",
    "db:init:postgres": "node src/scripts/initPostgresDb.js",
    "db:seed-videos": "node src/scripts/seedCloudinaryVideos.js",
    "db:seed-quizzes": "node src/scripts/seedAllQuizzes.js",
    "sync:production-quizzes": "node src/scripts/syncProductionQuizzes.js",
    "generate": "node src/scripts/generateTamilAudio.js",
    "generate:test": "node src/scripts/generateTamilAudio.js --test"
  },
  "keywords": [
    "tamil",
    "agaram",
    "education",
    "express",
    "mysql",
    "rest-api"
  ],
  "author": "AGARAM Team",
  "license": "ISC",
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "^2.68.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.12.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
